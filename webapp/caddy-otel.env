# HOL-229: OTEL env for the front caddy, sourced by the caddy-proxy recipe.
# Non-secret (stable tailnet DNS name, no keys). Lives in the repo (not the
# process-compose slot) because the slot runs `sudo -n`, which strips slot
# env — sourcing here is the only delivery path that survives the
# escalation. Override the path with CADDY_OTEL_ENV= (empty disables).
# OTLP/HTTP receiver: caddy's tracing module exports via OTLP/HTTP
# (HTTP/1.1 POST to /v1/traces); pointing it at SigNoz's gRPC-only :4317
# fails every export with "malformed HTTP response" (HOL-235). :4318 is
# the OTLP/HTTP receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz.elf-lizard.ts.net:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=orion-caddy
OTEL_TRACES_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext,baggage
